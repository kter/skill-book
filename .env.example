# Local development defaults (copy to .env and adjust)
ENVIRONMENT=local
DATABASE_URL=postgresql://skillbook:skillbook@localhost:5433/skillbook
# DSQL_CLUSTER_ENDPOINT=   # set automatically by `make dev-stack-dsql`; leave empty for local Postgres
AWS_PROFILE=dev
AWS_REGION=ap-northeast-1

# Per-version content explanations via Bedrock Sonnet (off locally by default).
# Set BEDROCK_ENABLED=true with valid AWS creds to generate them on publish.
# BEDROCK_ENABLED=false
# BEDROCK_REGION=ap-northeast-1
# BEDROCK_MODEL_ID=jp.anthropic.claude-sonnet-4-6
